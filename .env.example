# Server Configuration
PORT=5000

# Firebase Configuration
# 1. Project ID (from your Firebase Console: recd-website)
FIREBASE_PROJECT_ID=recd-website

# 2. Path to your downloaded service account key JSON file
# Save your downloaded JSON key to server/serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=server/serviceAccountKey.json

# OR 3. Raw or base64-encoded Service Account JSON string (useful for cloud deployments like Render/Railway/Fly.io)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
